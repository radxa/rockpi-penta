# Rock 3C Hardware Configuration
# This file is auto-generated during installation
# Only modify if you know what you're doing

# OLED Display (I2C)
SDA=GPIO1_A0
SCL=GPIO1_A1
OLED_RESET=GPIO3_B1

# Button Configuration
BUTTON_CHIP=3
BUTTON_LINE=1

# Fan Control
FAN_CHIP=3
FAN_LINE=2

# PWM Mode: 0=GPIO software PWM, 1=Hardware PWM
HARDWARE_PWM=0