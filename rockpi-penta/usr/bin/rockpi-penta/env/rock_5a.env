# Rock 5A Hardware Configuration
# This file is auto-generated during installation
# Only modify if you know what you're doing

# OLED Display (I2C)
SDA=I2C8_SDA_M4
SCL=I2C8_SCL_M4
OLED_RESET=GPIO1_A5

# Button Configuration
BUTTON_CHIP=4
BUTTON_LINE=11

# PWM Mode: 0=GPIO software PWM, 1=Hardware PWM
HARDWARE_PWM=1
PWMCHIP=14